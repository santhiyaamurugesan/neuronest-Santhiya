{
    "name": "backend",
    "version": "1.0.0",
    "description": "Jewelry Shop Backend",
    "main": "server.js",
    "type": "module",
    "scripts": {
        "start": "node server.js",
        "server": "nodemon server.js",
        "client": "npm run dev --prefix ../frontend",
        "dev": "concurrently \"npm run server\" \"npm run client\"",
        "data:import": "node seeder.js",
        "data:destroy": "node seeder.js -d",
        "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest"
    },
    "jest": {
        "testEnvironment": "node",
        "transform": {}
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "bcryptjs": "^2.4.3",
        "colors": "^1.4.0",
        "cors": "^2.8.5",
        "dotenv": "^16.0.3",
        "express": "^4.18.2",
        "express-async-handler": "^1.2.0",
        "express-mongo-sanitize": "^2.2.0",
        "express-rate-limit": "^8.2.1",
        "helmet": "^8.1.0",
        "jsonwebtoken": "^9.0.0",
        "mongoose": "^6.9.1",
        "multer": "^1.4.5-lts.1",
        "razorpay": "^2.9.6",
        "xss-clean": "^0.1.4"
    },
    "devDependencies": {
        "concurrently": "^7.6.0",
        "cross-env": "^10.1.0",
        "jest": "^30.2.0",
        "nodemon": "^2.0.20",
        "supertest": "^7.2.2"
    }
}